{
  "$schema": "../../../schemas/plugin.manifest.v1.schema.json",
  "schemaVersion": 1,
  "id": "com.chattree.official.github",
  "version": "1.0.4",
  "name": "GitHub",
  "description": "Official GitHub integration for Chattree. Inspect repositories, manage issues, view pull requests, and read source code directly in chat.",
  "author": "Chattree Core Team",
  "primaryCommand": "github",
  "aliases": [
    "gh",
    "git"
  ],
  "type": "imported",
  "category": "devtools",
  "capabilities": [
    "network.http",
    "storage.private",
    "open.url"
  ],
  "tags": [
    "github",
    "git",
    "devtools",
    "issues",
    "pullrequests",
    "official"
  ],
  "iconUrl": "https://raw.githubusercontent.com/Ponce5/Chattree/main/plugins/official/github/icon.png?v=1.0.4",
  "bannerUrl": "https://raw.githubusercontent.com/Ponce5/Chattree/main/plugins/official/github/banner.png?v=1.0.4",
  "changelog": "1.0.4: Direct WASM execution architecture matching ElevenLabs plugin. Fast config and status management.",
  "runtime": "wasm",
  "entrypoint": "github_entry",
  "wasmPath": "plugin.wasm",
  "wasmSha256": "1e5614edd090e1fadb3c70346d1df540b15b25ba9b7bfc5b6b621d8448f298d5",
  "runtimeApiVersion": "1.0.0",
  "maxMemoryPages": 64,
  "timeoutMs": 30000,
  "fuelLimit": 50000000,
  "tools": [
    {
      "id": "com.chattree.official.github.manager",
      "command": "github",
      "displayName": "GitHub Integration",
      "description": "Administra e interactúa con repositorios de GitHub. Configura tu token con /github config <token>, consulta tu cuenta con /github status, o inspecciona repositorios con /github repo <owner/repo>.",
      "capabilities": [
        "network.http",
        "storage.private",
        "open.url"
      ]
    }
  ]
}
