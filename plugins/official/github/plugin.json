{
  "$schema": "../../../schemas/plugin.manifest.v1.schema.json",
  "schemaVersion": 1,
  "id": "com.chattree.official.github",
  "version": "1.0.8",
  "name": "GitHub",
  "description": "Official GitHub integration for Chattree. Inspect repositories, list your projects, view issues, read READMEs, search code, create issues, and manage tokens using fully natural language.",
  "author": "Chattree Core Team",
  "primaryCommand": "github",
  "aliases": [
    "gh",
    "git"
  ],
  "type": "imported",
  "category": "devtools",
  "capabilities": [
    "network.http",
    "storage.private",
    "open.url"
  ],
  "tags": [
    "github",
    "git",
    "devtools",
    "issues",
    "pullrequests",
    "official"
  ],
  "iconUrl": "https://raw.githubusercontent.com/Ponce5/Chattree/main/plugins/official/github/icon.png?v=1.0.8",
  "bannerUrl": "https://raw.githubusercontent.com/Ponce5/Chattree/main/plugins/official/github/banner.png?v=1.0.8",
  "changelog": "1.0.8: Full dual NLP and intentContract support. Supports both Host API structured operations and direct natural language text fallback.",
  "runtime": "wasm",
  "entrypoint": "github_entry",
  "wasmPath": "plugin.wasm",
  "wasmSha256": "445bdaad5bb50441e8dcae1745cba73083def10dac42b5257eeb2f07c31eda35",
  "runtimeApiVersion": "1.0.0",
  "maxMemoryPages": 64,
  "timeoutMs": 30000,
  "fuelLimit": 50000000,
  "tools": [
    {
      "id": "com.chattree.official.github.manager",
      "command": "github",
      "displayName": "GitHub Integration",
      "description": "Interactúa con GitHub en lenguaje 100% natural. Puedes consultar tus repositorios, ver issues, leer el README de un proyecto, buscar código o crear issues en tus propias palabras.",
      "capabilities": [
        "network.http",
        "storage.private",
        "open.url"
      ],
      "intentContract": {
        "intent": "github_action",
        "validIntents": [
          "profile",
          "my_repos",
          "repo_info",
          "issues",
          "prs",
          "readme",
          "search",
          "create_issue",
          "config",
          "help"
        ],
        "description": "Interactúa con GitHub para consultar repositorios, leer READMEs, ver issues o PRs, buscar código, crear issues o gestionar la cuenta.",
        "fields": [
          {
            "name": "action",
            "key": "action",
            "type": "string",
            "description": "Acción a realizar: 'profile', 'my_repos', 'repo_info', 'issues', 'prs', 'readme', 'search', 'create_issue', 'config', 'help'",
            "required": true
          },
          {
            "name": "repo",
            "key": "repo",
            "type": "string",
            "description": "Repositorio en formato owner/repo (ej. Ponce5/Chattree)",
            "required": false
          },
          {
            "name": "query",
            "key": "query",
            "type": "string",
            "description": "Término o nombre de función para buscar código",
            "required": false
          },
          {
            "name": "title",
            "key": "title",
            "type": "string",
            "description": "Título del issue a crear",
            "required": false
          },
          {
            "name": "token",
            "key": "token",
            "type": "string",
            "description": "Personal Access Token de GitHub (ghp_...)",
            "required": false
          }
        ],
        "examples": [
          {
            "input": "dime qué repos tengo",
            "output": {
              "action": "my_repos"
            }
          },
          {
            "input": "explícame el README de Ponce5/Chattree",
            "output": {
              "action": "readme",
              "repo": "Ponce5/Chattree"
            }
          },
          {
            "input": "busca la función login en Ponce5/Chattree",
            "output": {
              "action": "search",
              "repo": "Ponce5/Chattree",
              "query": "login"
            }
          },
          {
            "input": "crea un issue en Ponce5/Chattree: El botón no funciona",
            "output": {
              "action": "create_issue",
              "repo": "Ponce5/Chattree",
              "title": "El botón no funciona"
            }
          }
        ],
        "maxResponseTokens": 120
      }
    }
  ]
}
