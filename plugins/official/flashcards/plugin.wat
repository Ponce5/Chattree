;; Chattree Official Flashcards / Study Tutor Plugin v1.0.0
;; Spaced Repetition (SRS) backed by private isolated SQLite (database.sql) + Minimalist Purple Flutter UI
(module
  (import "chattree" "host_call"
    (func $host_call (param i32 i32 i32 i32) (result i32))
  )

  (memory (export "memory") 32)

  (global $state       (mut i32) (i32.const 0))
  (global $act_len     (mut i32) (i32.const 0))
  (global $front_len   (mut i32) (i32.const 0))
  (global $back_len    (mut i32) (i32.const 0))
  (global $deck_len    (mut i32) (i32.const 0))
  (global $target_id   (mut i32) (i32.const 0))
  (global $rating_code (mut i32) (i32.const 2)) ;; 1=hard, 2=good, 3=easy

  (global $card_id     (mut i32) (i32.const 0))
  (global $card_int    (mut i32) (i32.const 0))
  (global $card_ease   (mut i32) (i32.const 250))
  (global $card_reps   (mut i32) (i32.const 0))
  (global $due_cnt     (mut i32) (i32.const 0))
  (global $total_cnt   (mut i32) (i32.const 0))
  (global $mastered    (mut i32) (i32.const 0))

  (global $out_ptr     (mut i32) (i32.const 65536))
  (global $req_ptr     (mut i32) (i32.const 300000))

  ;; ── Static Data Segments ─────────────────────────────────────────────
  (data (i32.const 200000) "{\22api\22:\22database\22,\22operation\22:\22execute\22,\22payload\22:{\22sql\22:\22CREATE TABLE IF NOT EXISTS flashcards (id INTEGER PRIMARY KEY AUTOINCREMENT, deck TEXT NOT NULL DEFAULT 'General', front TEXT NOT NULL, back TEXT NOT NULL, interval_days INTEGER NOT NULL DEFAULT 0, ease INTEGER NOT NULL DEFAULT 250, reps INTEGER NOT NULL DEFAULT 0, due_at INTEGER NOT NULL DEFAULT 0)\22}}\00") ;; sql_init (361)
  (data (i32.const 200368) "{\22api\22:\22database\22,\22operation\22:\22execute\22,\22payload\22:{\22sql\22:\22INSERT INTO flashcards (deck, front, back, interval_days, ease, reps, due_at) VALUES (?, ?, ?, 0, 250, 0, 0)\22,\22args\22:[\22\00") ;; sql_add_p1 (177)
  (data (i32.const 200552) "\22,\22\00") ;; sql_arg_sep (3)
  (data (i32.const 200560) "\22]}}\00") ;; sql_arg_end (4)
  (data (i32.const 200572) "{\22api\22:\22database\22,\22operation\22:\22query\22,\22payload\22:{\22sql\22:\22SELECT id, deck, front, back, interval_days, ease, reps, (SELECT COUNT(*) FROM flashcards WHERE due_at <= CAST(strftime('%s','now') AS INTEGER)) AS due_cnt, (SELECT COUNT(*) FROM flashcards) AS total_cnt FROM flashcards WHERE due_at <= CAST(strftime('%s','now') AS INTEGER) ORDER BY due_at ASC, id ASC LIMIT 1\22}}\00") ;; sql_next_due (368)
  (data (i32.const 200948) "{\22api\22:\22database\22,\22operation\22:\22query\22,\22payload\22:{\22sql\22:\22SELECT id, deck, front, back, interval_days, ease, reps, (SELECT COUNT(*) FROM flashcards) AS due_cnt, (SELECT COUNT(*) FROM flashcards) AS total_cnt FROM flashcards ORDER BY due_at ASC, id ASC LIMIT 1\22}}\00") ;; sql_next_practice (260)
  (data (i32.const 201216) "{\22api\22:\22database\22,\22operation\22:\22query\22,\22payload\22:{\22sql\22:\22SELECT id, deck, front, back, interval_days, ease, reps, (SELECT COUNT(*) FROM flashcards WHERE due_at <= CAST(strftime('%s','now') AS INTEGER)) AS due_cnt, (SELECT COUNT(*) FROM flashcards) AS total_cnt FROM flashcards WHERE id != ? ORDER BY due_at ASC, id ASC LIMIT 1\22,\22args\22:[\00") ;; sql_next_skip_p1 (335)
  (data (i32.const 201556) "]}}\00") ;; sql_num_end (3)
  (data (i32.const 201564) "{\22api\22:\22database\22,\22operation\22:\22query\22,\22payload\22:{\22sql\22:\22SELECT COUNT(*) AS total_cnt FROM flashcards\22}}\00") ;; sql_count_all (103)
  (data (i32.const 201672) "{\22api\22:\22database\22,\22operation\22:\22query\22,\22payload\22:{\22sql\22:\22SELECT id, deck, front, back, interval_days, ease, reps FROM flashcards WHERE id = ? LIMIT 1\22,\22args\22:[\00") ;; sql_get_p1 (158)
  (data (i32.const 201836) "{\22api\22:\22database\22,\22operation\22:\22execute\22,\22payload\22:{\22sql\22:\22UPDATE flashcards SET interval_days = ?, ease = ?, reps = ?, due_at = CAST(strftime('%s','now') AS INTEGER) + ? WHERE id = ?\22,\22args\22:[\00") ;; sql_upd_p1 (192)
  (data (i32.const 202036) "{\22api\22:\22database\22,\22operation\22:\22query\22,\22payload\22:{\22sql\22:\22SELECT id, deck, front, interval_days, reps FROM flashcards ORDER BY id DESC LIMIT 10\22}}\00") ;; sql_list (144)
  (data (i32.const 202188) "{\22api\22:\22database\22,\22operation\22:\22query\22,\22payload\22:{\22sql\22:\22SELECT COUNT(*) AS total_cnt, COALESCE(SUM(CASE WHEN due_at <= CAST(strftime('%s','now') AS INTEGER) THEN 1 ELSE 0 END), 0) AS due_cnt, COALESCE(SUM(CASE WHEN reps >= 3 THEN 1 ELSE 0 END), 0) AS mastered_cnt FROM flashcards\22}}\00") ;; sql_stats (282)
