{
  "$schema": "../../../schemas/plugin.manifest.v1.schema.json",
  "schemaVersion": 1,
  "id": "com.chattree.official.calendar",
  "version": "1.9.0",
  "name": "Calendar Plugin",
  "description": "Fast, token-optimized on-device calendar integration with English Flutter UI cards for event creation and /calendar overview, and natural-language responses for queries and edits.",
  "author": "Chattree Core Team",
  "primaryCommand": "calendar",
  "aliases": [
    "cal",
    "agenda"
  ],
  "type": "imported",
  "category": "productivity",
  "capabilities": [
    "calendar.read",
    "calendar.create",
    "calendar.update",
    "calendar.delete",
    "ui.components",
    "ai.context"
  ],
  "tags": [
    "calendar",
    "events",
    "agenda",
    "scheduler",
    "ui",
    "official"
  ],
  "iconUrl": "https://raw.githubusercontent.com/Ponce5/Chattree/main/plugins/official/calendar/icon.png?v=1.9.0",
  "bannerUrl": "https://raw.githubusercontent.com/Ponce5/Chattree/main/plugins/official/calendar/banner.png?v=1.9.0",
  "changelog": "1.9.0: Major token and performance optimization. Compacted manifest prompt schema, eliminated redundant ai.complete calls on UI cards and conversational queries, switched all predefined UI copy and action button labels to English ('View Events', 'Refresh', 'Retry' without raw slash commands), and balanced responses between Flutter UI cards (bare /calendar and create) and normal natural-language text (queries, updates, deletes, help).",
  "runtime": "wasm",
  "entrypoint": "calendar_entry",
  "wasmPath": "plugin.wasm",
  "wasmSha256": "871d46f04f513f3dcb577e36ca34e0b592485a8e76b8b9ec960dce0521813f1e",
  "runtimeApiVersion": "1.0.0",
  "maxMemoryPages": 32,
  "timeoutMs": 50000,
  "fuelLimit": 100000000,
  "inputOffset": 0,
  "outputOffset": 65536,
  "maxPayloadSizeBytes": 131072,
  "tools": [
    {
      "id": "com.chattree.official.calendar.manager",
      "command": "calendar",
      "displayName": "Device Calendar",
      "description": "Manage local device calendar. Always include \"tool\":\"calendar\" and return ONE JSON object. Actions: \"create\" (title, 24h ISO-8601 start & end YYYY-MM-DDTHH:mm:ss, durationMinutes default 60, optional description), \"events\" (optional startDate/endDate), \"update\" (eventId, calendarId, fields), \"delete\" (eventId, calendarId), \"help\".",
      "capabilities": [
        "calendar.read",
        "calendar.create",
        "calendar.update",
        "calendar.delete",
        "ui.components",
        "ai.context"
      ],
      "intentContract": {
        "intent": "create",
        "validIntents": [
          "create",
          "events",
          "list",
          "update",
          "delete",
          "help",
          "unknown"
        ],
        "description": "Always emit \"tool\":\"calendar\". Use 24h ISO-8601 timestamps.",
        "fields": [
          {
            "name": "action",
            "key": "action",
            "type": "string",
            "description": "create, events, update, delete, or help.",
            "required": true
          },
          {
            "name": "title",
            "key": "title",
            "type": "string",
            "description": "Concise event title.",
            "required": false
          },
          {
            "name": "start",
            "key": "start",
            "type": "string",
            "description": "Start YYYY-MM-DDTHH:mm:ss (24h).",
            "required": false
          },
          {
            "name": "end",
            "key": "end",
            "type": "string",
            "description": "End YYYY-MM-DDTHH:mm:ss (24h).",
            "required": false
          },
          {
            "name": "durationMinutes",
            "key": "durationMinutes",
            "type": "integer",
            "description": "Duration in minutes (default 60).",
            "required": false
          },
          {
            "name": "description",
            "key": "description",
            "type": "string",
            "description": "Optional notes or location.",
            "required": false
          },
          {
            "name": "calendarId",
            "key": "calendarId",
            "type": "string",
            "description": "Calendar ID for update/delete.",
            "required": false
          },
          {
            "name": "eventId",
            "key": "eventId",
            "type": "string",
            "description": "Event ID for update/delete.",
            "required": false
          }
        ],
        "examples": [
          {
            "input": "schedule dentist tomorrow at 4pm for 45 min at North Clinic",
            "output": {
              "tool": "calendar",
              "action": "create",
              "title": "Dentist",
              "start": "2026-04-06T16:00:00",
              "end": "2026-04-06T16:45:00",
              "durationMinutes": 45,
              "description": "North Clinic"
            }
          },
          {
            "input": "what events do I have this week?",
            "output": {
              "tool": "calendar",
              "action": "events"
            }
          },
          {
            "input": "delete event ev-9 in calendar cal-1",
            "output": {
              "tool": "calendar",
              "action": "delete",
              "eventId": "ev-9",
              "calendarId": "cal-1"
            }
          }
        ]
      }
    }
  ]
}
