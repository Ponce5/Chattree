{
  "$schema": "../../../schemas/plugin.manifest.v1.schema.json",
  "schemaVersion": 1,
  "id": "com.chattree.official.calendar",
  "version": "1.9.1",
  "name": "Calendar Plugin",
  "description": "Fast, token-optimized on-device calendar integration with English Flutter UI cards for event creation and /calendar overview, and grounded factual text responses for queries and edits.",
  "author": "Chattree Core Team",
  "primaryCommand": "calendar",
  "aliases": [
    "cal",
    "agenda"
  ],
  "type": "imported",
  "category": "productivity",
  "capabilities": [
    "calendar.read",
    "calendar.create",
    "calendar.update",
    "calendar.delete",
    "ui.components",
    "ai.context"
  ],
  "tags": [
    "calendar",
    "events",
    "agenda",
    "scheduler",
    "ui",
    "official"
  ],
  "iconUrl": "https://raw.githubusercontent.com/Ponce5/Chattree/main/plugins/official/calendar/icon.png?v=1.9.1",
  "bannerUrl": "https://raw.githubusercontent.com/Ponce5/Chattree/main/plugins/official/calendar/banner.png?v=1.9.1",
  "changelog": "1.9.1: Fixed hallucinated calendar responses by returning verbatim real device calendar data directly (type:'direct' text) for conversational queries/updates/deletes instead of passing raw JSON to a second LLM generation pass, and aligned calendar.events to resolve the same default writable calendarId via calendar.calendars used by calendar.create.",
  "runtime": "wasm",
  "entrypoint": "calendar_entry",
  "wasmPath": "plugin.wasm",
  "wasmSha256": "d227f036c09b13e18c4e7abccc4a47acd165a636edb66abfc8b36b9a17d40269",
  "runtimeApiVersion": "1.0.0",
  "maxMemoryPages": 32,
  "timeoutMs": 50000,
  "fuelLimit": 100000000,
  "inputOffset": 0,
  "outputOffset": 65536,
  "maxPayloadSizeBytes": 131072,
  "tools": [
    {
      "id": "com.chattree.official.calendar.manager",
      "command": "calendar",
      "displayName": "Device Calendar",
      "description": "Manage local device calendar. Always include \"tool\":\"calendar\" and return ONE JSON object. Actions: \"create\" (title, 24h ISO-8601 start & end YYYY-MM-DDTHH:mm:ss, durationMinutes default 60, optional description), \"events\" (omit start/end unless user asks for a specific date range), \"update\" (eventId, calendarId, fields), \"delete\" (eventId, calendarId), \"help\".",
      "capabilities": [
        "calendar.read",
        "calendar.create",
        "calendar.update",
        "calendar.delete",
        "ui.components",
        "ai.context"
      ],
      "intentContract": {
        "intent": "create",
        "validIntents": [
          "create",
          "events",
          "list",
          "update",
          "delete",
          "help",
          "unknown"
        ],
        "description": "Always emit \"tool\":\"calendar\". Use 24h ISO-8601 timestamps.",
        "fields": [
          {
            "name": "action",
            "key": "action",
            "type": "string",
            "description": "create, events, update, delete, or help.",
            "required": true
          },
          {
            "name": "title",
            "key": "title",
            "type": "string",
            "description": "Concise event title.",
            "required": false
          },
          {
            "name": "start",
            "key": "start",
            "type": "string",
            "description": "Start YYYY-MM-DDTHH:mm:ss (24h).",
            "required": false
          },
          {
            "name": "end",
            "key": "end",
            "type": "string",
            "description": "End YYYY-MM-DDTHH:mm:ss (24h).",
            "required": false
          },
          {
            "name": "durationMinutes",
            "key": "durationMinutes",
            "type": "integer",
            "description": "Duration in minutes (default 60).",
            "required": false
          },
          {
            "name": "description",
            "key": "description",
            "type": "string",
            "description": "Optional notes or location.",
            "required": false
          },
          {
            "name": "calendarId",
            "key": "calendarId",
            "type": "string",
            "description": "Calendar ID for update/delete.",
            "required": false
          },
          {
            "name": "eventId",
            "key": "eventId",
            "type": "string",
            "description": "Event ID for update/delete.",
            "required": false
          }
        ],
        "examples": [
          {
            "input": "schedule dentist tomorrow at 4pm for 45 min at North Clinic",
            "output": {
              "tool": "calendar",
              "action": "create",
              "title": "Dentist",
              "start": "2026-04-06T16:00:00",
              "end": "2026-04-06T16:45:00",
              "durationMinutes": 45,
              "description": "North Clinic"
            }
          },
          {
            "input": "what events do I have this week?",
            "output": {
              "tool": "calendar",
              "action": "events"
            }
          },
          {
            "input": "delete event ev-9 in calendar cal-1",
            "output": {
              "tool": "calendar",
              "action": "delete",
              "eventId": "ev-9",
              "calendarId": "cal-1"
            }
          }
        ]
      }
    }
  ]
}
