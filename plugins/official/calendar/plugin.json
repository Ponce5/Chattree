    "calendar.create",
    "calendar.read"
  ],
  "tags": [
    "calendar",
    "events",
    "agenda",
    "scheduler",
    "official"
  ],
  "changelog": "1.3.3: Direct JSON Host API support for high-precision event scheduling with custom dates and AI confirmation.",
  "runtime": "wasm",
  "entrypoint": "calendar_entry",
  "wasmPath": "plugin.wasm",
  "wasmSha256": "4a69496d659a3f9535c2f0a5c926df75b909cdb35cf298ebfc0680fdeaf7855d",
  "runtimeApiVersion": "1.0.0",
  "maxMemoryPages": 4,
  "timeoutMs": 5000,
  "fuelLimit": 50000000,
  "tools": [
    {
      "id": "com.chattree.official.calendar.manager",
      "command": "calendar",
