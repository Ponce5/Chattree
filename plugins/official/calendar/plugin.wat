  (data (i32.const 202100) "\5c\22. When JSON is requested, output ONLY one valid flat JSON object with the exact requested keys and plain-text values (no markdown *, #, backticks, or emojis). Never invent details not in DATA.\22,\22prompt\22:\22\00") ;; ai_req_p2 (len=206)
  (data (i32.const 202316) "\22,\22maxTokens\22:360,\22temperature\22:0.2,\22timeoutMs\22:18000}}\00") ;; ai_req_p3 (len=55)
  (data (i32.const 202380) "{\22api\22:\22ai\22,\22operation\22:\22complete\22,\22payload\22:{\22systemPrompt\22:\22You are Chattree Calendar assistant. Reply strictly in language code \5c\22\00") ;; ai_sys_help_p1 (len=133)
  (data (i32.const 202524) "\5c\22. Never output hardcoded templates; speak naturally and concisely.\22,\22prompt\22:\22\00") ;; ai_sys_help_p2 (len=80)
  (data (i32.const 202616) "lang=\00") ;; p_lang (len=5)
  (data (i32.const 202632) "\0a\00") ;; p_nl (len=1)
  (data (i32.const 202644) "DATA:\0aop=calendar_create\0asuccess=\00") ;; p_create_hdr (len=33)
  (data (i32.const 202688) "\0atitle=\00") ;; p_title (len=7)
  (data (i32.const 202704) "\0astart=\00") ;; p_start (len=7)
  (data (i32.const 202720) "\0aend=\00") ;; p_end (len=5)
  (data (i32.const 202736) "\0adescription=\00") ;; p_desc (len=13)
  (data (i32.const 202760) "\0aerror=\00") ;; p_err (len=7)
  (data (i32.const 202776) "\0aReturn ONLY JSON with keys: intro (1 friendly sentence confirming or explaining error), card_title, card_subtitle, badge (1-2 uppercase words), lbl_title, lbl_date, lbl_time, lbl_desc, btn_view (short button to open calendar), err_text (clear localized error if failed).\00") ;; p_create_ask (len=271)
  (data (i32.const 203056) "DATA:\0aop=calendar_events\0asuccess=\00") ;; p_events_hdr (len=33)
  (data (i32.const 203100) "\0acount=\00") ;; p_count (len=7)
  (data (i32.const 203116) "\0aevents=\00") ;; p_preview (len=8)
  (data (i32.const 203136) "\0aReturn ONLY JSON with keys: intro (1 short summary sentence in user language), card_title, card_subtitle, badge (1-2 uppercase words), empty_text (friendly empty-calendar text), all_day (short label like All day / Todo el dia), btn_refresh (short refresh button label), err_text (localized error if failed).\00") ;; p_events_ask (len=308)
  (data (i32.const 203456) "DATA:\0aop=\00") ;; p_mod_hdr (len=9)
  (data (i32.const 203476) "\0aeventId=\00") ;; p_evid (len=9)
  (data (i32.const 203496) "\0asuccess=\00") ;; p_success (len=9)
  (data (i32.const 203516) "\0aReturn ONLY JSON with keys: intro (1 sentence), card_title, card_subtitle, badge, lbl_status, val_status, lbl_id, btn_view, err_text.\00") ;; p_mod_ask (len=134)
  (data (i32.const 203660) "Reason: \00") ;; p_help_ask1 (len=8)
  (data (i32.const 203680) ". Explain concisely to the user how to use the Chattree Calendar plugin in their language: (1) Natural language with /calendar, e.g. scheduling with title, date, time, duration and notes/description; (2) Viewing upcoming events with /calendar alone or /calendar events; (3) Updating or deleting by eventId and calendarId; (4) Pipe format /calendar Title | YYYY-MM-DDTHH:mm:ss | YYYY-MM-DDTHH:mm:ss. If Reason is missing_title or missing_event_id, clearly say what information was missing and show a quick example.\00") ;; p_help_ask2 (len=513)
  (data (i32.const 204204) "{\22type\22:\22ui\22,\22displayText\22:\22\00") ;; ui_p1 (len=28)
  (data (i32.const 204244) "\22,\22ui\22:{\22title\22:\22\00") ;; ui_p2 (len=17)
  (data (i32.const 204272) "\22,\22subtitle\22:\22\00") ;; ui_sub (len=14)
  (data (i32.const 204296) "\22,\22badge\22:\22\00") ;; ui_badge (len=11)
  (data (i32.const 204316) "\22,\22badgeColor\22:\22green\22,\22icon\22:\22check\22,\22hideText\22:false,\22elements\22:[\00") ;; ui_bc_green (len=67)
  (data (i32.const 204392) "\22,\22badgeColor\22:\22green\22,\22icon\22:\22alarm\22,\22hideText\22:false,\22elements\22:[\00") ;; ui_bc_alarm (len=67)
  (data (i32.const 204468) "\22,\22badgeColor\22:\22blue\22,\22icon\22:\22info\22,\22hideText\22:false,\22elements\22:[\00") ;; ui_bc_blue (len=65)
  (data (i32.const 204544) "\22,\22badgeColor\22:\22red\22,\22icon\22:\22error\22,\22hideText\22:false,\22elements\22:[\00") ;; ui_bc_red (len=65)
  (data (i32.const 204620) "{\22type\22:\22key_value\22,\22items\22:[\00") ;; ui_kv_start (len=29)
