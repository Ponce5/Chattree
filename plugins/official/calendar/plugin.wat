    (local.set $p (call $copy_zstr (i32.const 202204) (local.get $p)))
    (if (i32.gt_s (global.get $calid_len) (i32.const 0))
      (then
        (local.set $p (call $copy_zstr (i32.const 202216) (local.get $p)))
        (local.set $p (call $copy_zstr (i32.const 202028) (local.get $p)))
        (local.set $p (call $copy_json_esc (i32.const 273000) (global.get $calid_len) (local.get $p)))
        (local.set $p (call $copy_zstr (i32.const 202204) (local.get $p)))
      )
    )
    (if (i32.gt_s (global.get $start_len) (i32.const 0))
      (then
        (local.set $p (call $copy_zstr (i32.const 202216) (local.get $p)))
        (local.set $p (call $copy_zstr (i32.const 202052) (local.get $p)))
        (local.set $p (call $copy_json_esc (i32.const 270700) (global.get $start_len) (local.get $p)))
        (local.set $p (call $copy_zstr (i32.const 202204) (local.get $p)))
        (local.set $p (call $copy_zstr (i32.const 202216) (local.get $p)))
        (local.set $p (call $copy_zstr (i32.const 202072) (local.get $p)))
        (local.set $p (call $copy_json_esc (i32.const 270700) (global.get $start_len) (local.get $p)))
        (local.set $p (call $copy_zstr (i32.const 202204) (local.get $p)))
