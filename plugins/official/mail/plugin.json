{
  "$schema": "../../../schemas/plugin.manifest.v1.schema.json",
  "schemaVersion": 1,
  "id": "com.chattree.official.gmail",
  "version": "2.4.0",
  "name": "Gmail",
  "description": "Fast, token-optimized Gmail & IMAP/SMTP plugin with English Flutter UI status/setup cards and natural-language inbox, reading, and sending.",
  "author": "Chattree Core Team",
  "primaryCommand": "gmail",
  "aliases": [
    "mail",
    "email"
  ],
  "type": "imported",
  "category": "productivity",
  "capabilities": [
    "storage.private",
    "email.read",
    "email.send",
    "ui.components",
    "ai.context"
  ],
  "tags": [
    "gmail",
    "google",
    "mail",
    "email",
    "imap",
    "smtp",
    "ui",
    "official"
  ],
  "iconUrl": "https://raw.githubusercontent.com/Ponce5/Chattree/main/plugins/official/mail/icon.png?v=2.4.0",
  "bannerUrl": "https://raw.githubusercontent.com/Ponce5/Chattree/main/plugins/official/mail/banner.png?v=2.4.0",
  "changelog": "2.4.0: Major token and performance optimization. Compacted manifest prompt schema, eliminated redundant ai.complete calls on status/config Flutter UI cards and conversational inbox/read/send/disconnect flows, switched all predefined UI copy and action button labels to English ('View Inbox', 'Check Status', 'Help', 'Disconnect', 'Retry' without raw slash commands), and kept natural-language text responses for inbox, reading, sending, and help.",
  "runtime": "wasm",
  "entrypoint": "mail_entry",
  "wasmPath": "plugin.wasm",
  "wasmSha256": "9545dc23f0b2cf12754f19f133840b395f69589c7394ab30778eec9f120527d3",
  "runtimeApiVersion": "1.0.0",
  "maxMemoryPages": 32,
  "timeoutMs": 50000,
  "fuelLimit": 100000000,
  "inputOffset": 0,
  "outputOffset": 65536,
  "maxPayloadSizeBytes": 262144,
  "tools": [
    {
      "id": "com.chattree.official.gmail.manager",
      "command": "gmail",
      "displayName": "Gmail & Inbox",
      "description": "Manage Gmail via IMAP/SMTP. Always include \"tool\":\"gmail\" and return ONE JSON object. Actions: \"config\" (email, full 16-letter App Password including all 4 groups like \"abcd efgh ijkl mnop\", optional imapHost/smtpHost), \"status\", \"inbox\", \"read\" (id), \"send\" (to, subject, body), \"disconnect\", \"help\".",
      "capabilities": [
        "storage.private",
        "email.read",
        "email.send",
        "ui.components",
        "ai.context"
      ],
      "intentContract": {
        "intent": "mail_inbox",
        "validIntents": [
          "config",
          "status",
          "inbox",
          "read",
          "send",
          "disconnect",
          "help",
          "unknown"
        ],
        "description": "Always emit \"tool\":\"gmail\". Preserve full 4-group App Password in config.",
        "fields": [
          {
            "name": "action",
            "key": "action",
            "type": "string",
            "description": "config, status, inbox, read, send, disconnect, or help.",
            "required": true
          },
          {
            "name": "email",
            "key": "email",
            "type": "string",
            "description": "Email address (config).",
            "required": false
          },
          {
            "name": "password",
            "key": "password",
            "type": "string",
            "description": "Full App Password with all 4 groups (config).",
            "required": false
          },
          {
            "name": "id",
            "key": "id",
            "type": "string",
            "description": "Message ID (read).",
            "required": false
          },
          {
            "name": "to",
            "key": "to",
            "type": "string",
            "description": "Recipient email (send).",
            "required": false
          },
          {
            "name": "subject",
            "key": "subject",
            "type": "string",
            "description": "Email subject (send).",
            "required": false
          },
          {
            "name": "body",
            "key": "body",
            "type": "string",
            "description": "Email body text (send).",
            "required": false
          }
        ],
        "examples": [
          {
            "input": "config user@gmail.com abcd efgh ijkl mnop",
            "output": {
              "tool": "gmail",
              "action": "config",
              "email": "user@gmail.com",
              "password": "abcd efgh ijkl mnop"
            }
          },
          {
            "input": "check my inbox",
            "output": {
              "tool": "gmail",
              "action": "inbox"
            }
          },
          {
            "input": "read email 42",
            "output": {
              "tool": "gmail",
              "action": "read",
              "id": "42"
            }
          },
          {
            "input": "send an email to alex@example.com about Hello saying How are you?",
            "output": {
              "tool": "gmail",
              "action": "send",
              "to": "alex@example.com",
              "subject": "Hello",
              "body": "How are you?"
            }
          }
        ]
      }
    }
  ]
}
