{
  "$schema": "../../../schemas/plugin.manifest.v1.schema.json",
  "schemaVersion": 1,
  "id": "com.chattree.official.gmail",
  "version": "2.1.1",
  "name": "Gmail",
  "description": "Official on-device Gmail integration powered by Chattree's native Email Host API with real Google IMAP and SMTP support.",
  "author": "Chattree Core Team",
  "primaryCommand": "gmail",
  "aliases": [
    "mail",
    "email"
  ],
  "type": "imported",
  "category": "productivity",
  "capabilities": [
    "storage.private",
    "email.read",
    "email.send"
  ],
  "tags": [
    "gmail",
    "google",
    "mail",
    "email",
    "imap",
    "official"
  ],
  "iconUrl": "https://raw.githubusercontent.com/Ponce5/Chattree/main/plugins/official/mail/icon.png?v=2.1.1",
  "bannerUrl": "https://raw.githubusercontent.com/Ponce5/Chattree/main/plugins/official/mail/banner.png?v=2.1.1",
  "changelog": "2.1.1: Updated official Gmail branding with official Google Workspace icons and banner.",
  "runtime": "wasm",
  "entrypoint": "mail_entry",
  "wasmPath": "plugin.wasm",
  "wasmSha256": "2dc595bfcd5eb98fd34f16200558c46041be8c72694e28841769514335720604",
  "runtimeApiVersion": "1.0.0",
  "maxMemoryPages": 4,
  "timeoutMs": 15000,
  "fuelLimit": 50000000,
  "tools": [
    {
      "id": "com.chattree.official.gmail.manager",
      "command": "gmail",
      "displayName": "Gmail & Inbox",
      "description": "Herramienta oficial de Gmail conectada al Host API nativo de Chattree. Lee la bandeja de entrada real del usuario mediante IMAP, lee correos completos por ID, despacha correos por SMTP y administra cuentas de forma segura. Subcomandos: /gmail, /gmail inbox, /gmail read <id>, /gmail send <destinatario> | <asunto> | <mensaje>, /gmail config <correo> <contrasena_aplicacion>, /gmail disconnect.",
      "capabilities": [
        "storage.private",
        "email.read",
        "email.send"
      ],
      "intentContract": {
        "intent": "mail_inbox",
        "validIntents": [
          "config",
          "inbox",
          "read",
          "send",
          "disconnect"
        ],
        "description": "Lee correos reales de la bandeja de entrada de Gmail, consulta mensajes detallados o envia correos.",
        "fields": [
          {
            "name": "action",
            "key": "action",
            "type": "string",
            "description": "Accion a realizar: 'config' para configurar cuenta, 'inbox' para leer la bandeja, 'read' para abrir un correo, 'send' para enviar, 'disconnect' para desconectar",
            "required": true
          },
          {
            "name": "id",
            "key": "id",
            "type": "string",
            "description": "ID del mensaje para leer (solo para action=read)",
            "required": false
          },
          {
            "name": "email",
            "key": "email",
            "type": "string",
            "description": "Correo electronico del usuario (solo para action=config)",
            "required": false
          },
          {
            "name": "password",
            "key": "password",
            "type": "string",
            "description": "Contrasena de aplicacion (solo para action=config)",
            "required": false
          },
          {
            "name": "to",
            "key": "to",
            "type": "string",
            "description": "Destinatario del correo (solo para action=send)",
            "required": false
          },
          {
            "name": "subject",
            "key": "subject",
            "type": "string",
            "description": "Asunto del correo (solo para action=send)",
            "required": false
          },
          {
            "name": "body",
            "key": "body",
            "type": "string",
            "description": "Cuerpo del mensaje (solo para action=send)",
            "required": false
          }
        ],
        "examples": [
          {
            "input": "revisa mis correos",
            "output": {
              "INTENT": "inbox",
              "action": "inbox"
            }
          },
          {
            "input": "qué correos tengo?",
            "output": {
              "INTENT": "inbox",
              "action": "inbox"
            }
          },
          {
            "input": "configura mi cuenta usuario@ejemplo.com con contraseña abcd efgh ijkl mnop",
            "output": {
              "INTENT": "config",
              "action": "config",
              "email": "usuario@ejemplo.com",
              "password": "abcd efgh ijkl mnop"
            }
          }
        ]
      }
    }
  ]
}