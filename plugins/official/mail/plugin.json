{
  "$schema": "../../../schemas/plugin.manifest.v1.schema.json",
  "schemaVersion": 1,
  "id": "com.chattree.official.gmail",
  "version": "2.2.0",
  "name": "Gmail",
  "description": "Official on-device Gmail and IMAP/SMTP integration powered by Chattree's native Email Host API. Read your inbox, inspect full messages, and send emails directly from chat.",
  "author": "Chattree Core Team",
  "primaryCommand": "gmail",
  "aliases": [
    "mail",
    "email"
  ],
  "type": "imported",
  "category": "productivity",
  "capabilities": [
    "storage.private",
    "email.read",
    "email.send"
  ],
  "tags": [
    "gmail",
    "google",
    "mail",
    "email",
    "imap",
    "smtp",
    "official"
  ],
  "iconUrl": "https://raw.githubusercontent.com/Ponce5/Chattree/main/plugins/official/mail/icon.png?v=2.2.0",
  "bannerUrl": "https://raw.githubusercontent.com/Ponce5/Chattree/main/plugins/official/mail/banner.png?v=2.2.0",
  "changelog": "2.2.0: Fixed intentContract JSON routing, implemented send and help operations, fixed config prefix/offset bug, removed 1-2 char command collisions, expanded memory to 32 pages (2 MB) with inputOffset/outputOffset, and unified English minimalist Chattree documentation.",
  "runtime": "wasm",
  "entrypoint": "mail_entry",
  "wasmPath": "plugin.wasm",
  "wasmSha256": "eb9fde7280ab48fcff610ed5377f955ba03f1df922d639dfa80c37643183b5b0",
  "runtimeApiVersion": "1.0.0",
  "maxMemoryPages": 32,
  "timeoutMs": 25000,
  "fuelLimit": 50000000,
  "inputOffset": 0,
  "outputOffset": 65536,
  "maxPayloadSizeBytes": 262144,
  "tools": [
    {
      "id": "com.chattree.official.gmail.manager",
      "command": "gmail",
      "displayName": "Gmail & Inbox",
      "description": "Official Gmail & IMAP/SMTP email integration. Output ONLY a single valid JSON object with no extra text. Supports 'inbox', 'read' (requires 'id'), 'send' (requires 'to', 'subject', 'body'), 'config' (requires 'email', 'password'), 'disconnect', and 'help'.",
      "capabilities": [
        "storage.private",
        "email.read",
        "email.send"
      ],
      "intentContract": {
        "intent": "mail_inbox",
        "validIntents": [
          "inbox",
          "read",
          "send",
          "config",
          "disconnect",
          "help"
        ],
        "description": "Interpret the user's natural-language email request and return ONE valid JSON tool call only.",
        "fields": [
          {
            "name": "action",
            "key": "action",
            "type": "string",
            "description": "Action to perform: 'inbox' (list recent emails), 'read' (open a message by id), 'send' (send an email), 'config' (save email and app password), 'disconnect' (remove saved credentials), or 'help' (show usage).",
            "required": true
          },
          {
            "name": "id",
            "key": "id",
            "type": "string",
            "description": "Message ID to open (required for action='read').",
            "required": false
          },
          {
            "name": "email",
            "key": "email",
            "type": "string",
            "description": "User email address (required for action='config').",
            "required": false
          },
          {
            "name": "password",
            "key": "password",
            "type": "string",
            "description": "App password or account password (required for action='config').",
            "required": false
          },
          {
            "name": "to",
            "key": "to",
            "type": "string",
            "description": "Recipient email address (required for action='send').",
            "required": false
          },
          {
            "name": "subject",
            "key": "subject",
            "type": "string",
            "description": "Email subject line (for action='send').",
            "required": false
          },
          {
            "name": "body",
            "key": "body",
            "type": "string",
            "description": "Email body content (for action='send').",
            "required": false
          }
        ],
        "examples": [
          {
            "input": "check my inbox",
            "output": {
              "INTENT": "inbox",
              "action": "inbox"
            }
          },
          {
            "input": "read email 42",
            "output": {
              "INTENT": "read",
              "action": "read",
              "id": "42"
            }
          },
          {
            "input": "send an email to alex@example.com with subject Hello and body How are you?",
            "output": {
              "INTENT": "send",
              "action": "send",
              "to": "alex@example.com",
              "subject": "Hello",
              "body": "How are you?"
            }
          }
        ]
      }
    }
  ]
}
