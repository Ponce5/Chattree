  (data (i32.const 341996) "/gmail disconnect\00") ;; def_cmd_disc (len=17)
  (data (i32.const 342024) " \e2\80\a2 \00") ;; def_dot (len=5)
  (data (i32.const 342040) ":\00") ;; def_colon (len=1)
  (data (i32.const 342052) "[\00") ;; def_lbr (len=1)
  (data (i32.const 342064) "] \00") ;; def_rbr (len=2)
  (data (i32.const 342076) "\e2\97\8f \00") ;; def_star (len=4)
  (data (i32.const 342092) "help\00") ;; r_help (len=4)
  (data (i32.const 342108) "missing_config\00") ;; r_miss_cfg (len=14)
  (data (i32.const 342132) "missing_id\00") ;; r_miss_id (len=10)
  (data (i32.const 342152) "missing_send\00") ;; r_miss_send (len=12)
  (data (i32.const 342176) "{\22api\22:\22storage\22,\22operation\22:\22get\22,\22payload\22:{\22key\22:\22\00") ;; req_st_get_p (len=53)
  (data (i32.const 342240) "{\22api\22:\22email\22,\22operation\22:\22inbox\22,\22payload\22:{}}\00") ;; req_em_inbox (len=48)
  (data (i32.const 342300) "{\22api\22:\22email\22,\22operation\22:\22disconnect\22,\22payload\22:{}}\00") ;; req_em_disc (len=53)
  (data (i32.const 342364) "{\22api\22:\22email\22,\22operation\22:\22config\22,\22payload\22:{\22email\22:\22\00") ;; req_em_cfg_p (len=56)
  (data (i32.const 342432) "{\22api\22:\22email\22,\22operation\22:\22read\22,\22payload\22:{\22id\22:\22\00") ;; req_em_read_p (len=51)
  (data (i32.const 342492) "{\22api\22:\22email\22,\22operation\22:\22send\22,\22payload\22:{\22to\22:\22\00") ;; req_em_send_p (len=51)
  (data (i32.const 342552) "}}\00") ;; req_end (len=2)
  (data (i32.const 342564) "\22\00") ;; jf_q (len=1)
  (data (i32.const 342576) ",\00") ;; jf_comma (len=1)
  (data (i32.const 342588) "\22password\22:\22\00") ;; jf_pass (len=12)
  (data (i32.const 342612) "\22imapHost\22:\22\00") ;; jf_imaph (len=12)
  (data (i32.const 342636) "\22imapPort\22:\22\00") ;; jf_imapp (len=12)
  (data (i32.const 342660) "\22smtpHost\22:\22\00") ;; jf_smtph (len=12)
  (data (i32.const 342684) "\22smtpPort\22:\22\00") ;; jf_smtpp (len=12)
  (data (i32.const 342708) "\22subject\22:\22\00") ;; jf_subj (len=11)
  (data (i32.const 342728) "\22body\22:\22\00") ;; jf_body (len=8)
  (data (i32.const 342748) "{\22api\22:\22ai\22,\22operation\22:\22complete\22,\22payload\22:{\22systemPrompt\22:\22You are Chattree Gmail assistant. Write natural, accurate text strictly in language code \5c\22\00") ;; ai_req_p1 (len=153)
  (data (i32.const 342912) "\5c\22. When JSON is requested, output ONLY one valid flat JSON object with the exact requested keys and plain-text values (no markdown *, #, backticks, or emojis). Never invent data or credentials not in DATA.\22,\22prompt\22:\22\00") ;; ai_req_p2 (len=218)
  (data (i32.const 343140) "\22,\22maxTokens\22:420,\22temperature\22:0.2,\22timeoutMs\22:18000}}\00") ;; ai_req_p3 (len=55)
  (data (i32.const 343204) "{\22api\22:\22ai\22,\22operation\22:\22complete\22,\22payload\22:{\22systemPrompt\22:\22You are Chattree Gmail assistant. Reply strictly in language code \5c\22\00") ;; ai_sys_help_p1 (len=130)
  (data (i32.const 343344) "\5c\22. Never use hardcoded fixed text; explain clearly and naturally in the user language.\22,\22prompt\22:\22\00") ;; ai_sys_help_p2 (len=99)
  (data (i32.const 343452) "DATA:\0aop=gmail_status\0aconfigured=\00") ;; p_st_hdr (len=33)
  (data (i32.const 343496) "\0aimap_verified=\00") ;; p_verified (len=15)
  (data (i32.const 343520) "\0aaccount=\00") ;; p_account (len=9)
  (data (i32.const 343540) "\0aimap=\00") ;; p_imap (len=6)
  (data (i32.const 343556) "\0asmtp=\00") ;; p_smtp (len=6)
  (data (i32.const 343572) "\0aunread_count=\00") ;; p_unread (len=14)
  (data (i32.const 343596) "\0atotal_count=\00") ;; p_total (len=13)
  (data (i32.const 343620) "\0aerror=\00") ;; p_err (len=7)
  (data (i32.const 343636) "\0aReturn ONLY JSON with keys: intro (1 friendly sentence explaining Gmail is not configured yet), card_title, card_subtitle, badge, lbl_status, val_status, lbl_cmd, guide (concise step-by-step setup guide: enable Google 2-Step Verification, generate a 16-char App Password at myaccount.google.com/security, run /gmail config <email> <16-char-password>), btn_1 (label for Help).\00") ;; p_st_ask_uncfg (len=376)
  (data (i32.const 344024) "\0aReturn ONLY JSON with keys: intro (1 sentence confirming Gmail is connected and IMAP verified), card_title, card_subtitle, badge, lbl_status, val_status, lbl_account, lbl_imap, lbl_smtp, lbl_unread, btn_1 (Inbox), btn_2 (Help), btn_3 (Disconnect).\00") ;; p_st_ask_ok (len=248)
  (data (i32.const 344284) "\0aReturn ONLY JSON with keys: intro (1 sentence explaining saved credentials failed IMAP check), card_title, card_subtitle, badge, lbl_status, val_status, lbl_account, lbl_imap, err_text (clear advice to verify App Password and re-run /gmail config), btn_1 (Retry), btn_2 (Disconnect).\00") ;; p_st_ask_err (len=284)
  (data (i32.const 344580) "DATA:\0aop=gmail_config\0asuccess=\00") ;; p_cfg_hdr (len=30)
  (data (i32.const 344620) "\0aprovider=\00") ;; p_prov (len=10)
  (data (i32.const 344640) "\0aReturn ONLY JSON with keys: intro (1 sentence), card_title, card_subtitle, badge, lbl_account, lbl_provider, lbl_status, val_status, err_text (if failed, explain Google App Password / IMAP auth fix), btn_1 (Inbox if ok, Help if failed), btn_2 (Status if ok).\00") ;; p_cfg_ask (len=259)
  (data (i32.const 344908) "DATA:\0aop=gmail_inbox\0asuccess=\00") ;; p_inb_hdr (len=29)
  (data (i32.const 344948) "\0aemails=\00") ;; p_preview (len=8)
  (data (i32.const 344968) "\0aReturn ONLY JSON with keys: intro (1 concise summary sentence mentioning unread count or highlights), card_title, card_subtitle, badge, empty_text, unread_tag (short word like UNREAD), btn_1 (Refresh), btn_2 (Status), err_text.\00") ;; p_inb_ask (len=228)
  (data (i32.const 345208) "DATA:\0aop=gmail_read\0asuccess=\00") ;; p_rd_hdr (len=28)
  (data (i32.const 345248) "\0afrom=\00") ;; p_from (len=6)
  (data (i32.const 345264) "\0ato=\00") ;; p_to (len=4)
  (data (i32.const 345280) "\0asubject=\00") ;; p_subj (len=9)
  (data (i32.const 345300) "\0adate=\00") ;; p_date (len=6)
  (data (i32.const 345316) "\0abody_preview=\00") ;; p_body (len=14)
  (data (i32.const 345340) "\0aReturn ONLY JSON with keys: intro (1 concise summary sentence of the email), card_title, card_subtitle, badge, lbl_from, lbl_to, lbl_subject, lbl_date, btn_1 (Inbox), err_text.\00") ;; p_rd_ask (len=177)
  (data (i32.const 345528) "DATA:\0aop=gmail_send\0asuccess=\00") ;; p_sd_hdr (len=28)
  (data (i32.const 345568) "\0aReturn ONLY JSON with keys: intro (1 sentence), card_title, card_subtitle, badge, lbl_to, lbl_subject, lbl_status, val_status, err_text, btn_1 (Inbox).\00") ;; p_sd_ask (len=152)
  (data (i32.const 345732) "DATA:\0aop=gmail_disconnect\0asuccess=\00") ;; p_dc_hdr (len=34)
  (data (i32.const 345776) "\0aReturn ONLY JSON with keys: intro (1 sentence), card_title, card_subtitle, badge, lbl_status, val_status, err_text, btn_1 (Status).\00") ;; p_dc_ask (len=132)
  (data (i32.const 345920) "Reason: \00") ;; p_help_1 (len=8)
  (data (i32.const 345940) ". Explain clearly in the user language how to set up and use Gmail in Chattree: (1) Enable Google 2-Step Verification at myaccount.google.com/security and create a 16-letter App Password; (2) Connect using /gmail config <email> <app_password> (works with 4 space-separated groups like abcd efgh ijkl mnop); (3) Check connection status anytime by typing /gmail alone; (4) Read inbox with /gmail inbox or natural language, open an email with /gmail read <id>, send with /gmail send <to> | <subject> | <body> or natural language, and unlink with /gmail disconnect. If Reason is missing_config, missing_id, or missing_send, clearly explain which parameters were missing and show an example.\00") ;; p_help_2 (len=686)
  (data (i32.const 346636) "{\22type\22:\22ui\22,\22displayText\22:\22\00") ;; ui_p1 (len=28)
  (data (i32.const 346676) "\22,\22ui\22:{\22title\22:\22\00") ;; ui_p2 (len=17)
  (data (i32.const 346704) "\22,\22subtitle\22:\22\00") ;; ui_sub (len=14)
  (data (i32.const 346728) "\22,\22badge\22:\22\00") ;; ui_badge (len=11)
  (data (i32.const 346748) "\22,\22badgeColor\22:\22green\22,\22icon\22:\22check\22,\22hideText\22:false,\22elements\22:[\00") ;; ui_bc_green (len=67)
  (data (i32.const 346824) "\22,\22badgeColor\22:\22orange\22,\22icon\22:\22warning\22,\22hideText\22:false,\22elements\22:[\00") ;; ui_bc_orange (len=70)
  (data (i32.const 346904) "\22,\22badgeColor\22:\22red\22,\22icon\22:\22error\22,\22hideText\22:false,\22elements\22:[\00") ;; ui_bc_red (len=65)
  (data (i32.const 346980) "\22,\22badgeColor\22:\22blue\22,\22icon\22:\22info\22,\22hideText\22:false,\22elements\22:[\00") ;; ui_bc_blue (len=65)
  (data (i32.const 347056) "\22,\22badgeColor\22:\22green\22,\22icon\22:\22message\22,\22hideText\22:false,\22elements\22:[\00") ;; ui_bc_msg (len=69)
  (data (i32.const 347136) "{\22type\22:\22key_value\22,\22items\22:[\00") ;; ui_kv_start (len=29)
  (data (i32.const 347176) "{\22key\22:\22\00") ;; ui_kv_item1 (len=8)
  (data (i32.const 347196) "\22,\22value\22:\22\00") ;; ui_kv_item2 (len=11)
  (data (i32.const 347216) "\22}\00") ;; ui_kv_item3 (len=2)
  (data (i32.const 347228) "{\22type\22:\22list\22,\22items\22:[\00") ;; ui_list_start (len=24)
  (data (i32.const 347264) "{\22title\22:\22\00") ;; ui_list_item1 (len=10)
