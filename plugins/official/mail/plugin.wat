  (data (i32.const 341756) "Gmail\00") ;; def_gmail (len=5)
  (data (i32.const 341772) "OK\00") ;; def_ok (len=2)
  (data (i32.const 341784) "ERR\00") ;; def_err (len=3)
  (data (i32.const 341796) "true\00") ;; def_true (len=4)
  (data (i32.const 341812) "false\00") ;; def_false (len=5)
  (data (i32.const 341828) "imap.gmail.com\00") ;; def_imap_def (len=14)
