        (call $out_z (i32.const 347228))
        (local.set $cnt (i32.const 0))
        (if (call $find_array_start (i32.const 1260000) (global.get $saved_res_len) (i32.const 341228))
          (then
            (loop $em_l
              (if (i32.and (i32.lt_s (local.get $cnt) (i32.const 15))
                           (call $next_array_obj (i32.const 1260000) (global.get $saved_res_len)))
                (then
                  (local.set $idl (call $extract_json_str (global.get $arr_obj_start) (global.get $arr_obj_len) (i32.const 340384) (i32.const 454500) (i32.const 48)))
                  (local.set $fl (call $extract_json_str (global.get $arr_obj_start) (global.get $arr_obj_len) (i32.const 341244) (i32.const 453400) (i32.const 120)))
                  (local.set $sl (call $extract_json_str (global.get $arr_obj_start) (global.get $arr_obj_len) (i32.const 340484) (i32.const 453700) (i32.const 120)))
                  (local.set $dl (call $extract_json_str (global.get $arr_obj_start) (global.get $arr_obj_len) (i32.const 341260) (i32.const 454000) (i32.const 48)))
                  (local.set $snl (call $extract_json_str (global.get $arr_obj_start) (global.get $arr_obj_len) (i32.const 341292) (i32.const 454200) (i32.const 160)))
                  (local.set $unr (call $extract_json_bool (global.get $arr_obj_start) (global.get $arr_obj_len) (i32.const 341276)))

                  ;; Assemble item title: [id] (● )subject into 449200
                  (local.set $p (i32.const 449200))
                  (if (i32.gt_s (local.get $idl) (i32.const 0))
                    (then
                      (local.set $p (call $copy_zstr (i32.const 342052) (local.get $p)))
                      (local.set $p (call $copy_mem (i32.const 454500) (local.get $p) (local.get $idl)))
                      (local.set $p (call $copy_zstr (i32.const 342064) (local.get $p)))
                    )
                  )
                  (if (i32.eq (local.get $unr) (i32.const 1))
                    (then (local.set $p (call $copy_zstr (i32.const 342076) (local.get $p))))
                  )
                  (if (i32.gt_s (local.get $sl) (i32.const 0))
                    (then (local.set $p (call $copy_mem (i32.const 453700) (local.get $p) (call $utf8_clamp (i32.const 453700) (local.get $sl) (i32.const 70)))))
                  )
                  (if (i32.gt_s (local.get $cnt) (i32.const 0)) (then (call $out_z (i32.const 342576))))
                  (call $out_z (i32.const 347264))
                  (call $out_json_esc (i32.const 449200) (i32.sub (local.get $p) (i32.const 449200)) (i32.const 95))
                  (call $out_z (i32.const 347284))

                  ;; Assemble subtitle: from • date(16) • snippet into 449200
                  (local.set $p (i32.const 449200))
                  (if (i32.gt_s (local.get $fl) (i32.const 0))
                    (then (local.set $p (call $copy_mem (i32.const 453400) (local.get $p) (call $utf8_clamp (i32.const 453400) (local.get $fl) (i32.const 60)))))
                  )
                  (if (i32.gt_s (local.get $dl) (i32.const 0))
                    (then
                      (if (i32.gt_s (local.get $p) (i32.const 449200)) (then (local.set $p (call $copy_zstr (i32.const 342024) (local.get $p)))))
                      (local.set $p (call $copy_mem (i32.const 454000) (local.get $p) (call $utf8_clamp (i32.const 454000) (local.get $dl) (i32.const 16))))
                    )
                  )
                  (if (i32.gt_s (local.get $snl) (i32.const 0))
                    (then
                      (if (i32.gt_s (local.get $p) (i32.const 449200)) (then (local.set $p (call $copy_zstr (i32.const 342024) (local.get $p)))))
                      (local.set $p (call $copy_mem (i32.const 454200) (local.get $p) (call $utf8_clamp (i32.const 454200) (local.get $snl) (i32.const 70))))
                    )
                  )
                  (call $out_json_esc (i32.const 449200) (i32.sub (local.get $p) (i32.const 449200)) (i32.const 155))
                  (call $out_z (i32.const 347308))

                  (local.set $cnt (i32.add (local.get $cnt) (i32.const 1)))
                  (br $em_l)
                )
              )
            )
          )
        )
        (call $out_z (i32.const 347368))
      )
    )
    (call $out_z (i32.const 342576))
    (call $out_z (i32.const 347380))
    (call $out_z (i32.const 342576))
    (call $out_z (i32.const 347408))
    (call $emit_btn (i32.const 504600) (global.get $ai_b1_len) (i32.const 341952) (i32.const 347512) (i32.const 1))
