    )

    (if (i32.le_s (global.get $g_total_cnt) (i32.const 0))
      (then
        (call $emit_ui_header (i32.const 497000) (global.get $ai_intro_len) (local.get $sub_p) (local.get $sub_l) (i32.const 341772) (i32.const 346980))
