    )
    (local.set $p (call $copy_json_esc (i32.const 345340) (i32.const 177) (local.get $p)))
    (local.set $p (call $copy_zstr (i32.const 343140) (local.get $p)))
    (call $dispatch_host (i32.sub (local.get $p) (i32.const 560000)))
  )

  (func $call_ai_send (result i32)
    (local $p i32)
    (global.set $g_state (i32.const 24))
    (local.set $p (call $begin_ai_json_req))
    (local.set $p (call $copy_json_esc (i32.const 345528) (i32.const 28) (local.get $p)))
    (if (global.get $g_op_ok)
      (then (local.set $p (call $copy_zstr (i32.const 341796) (local.get $p))))
      (else (local.set $p (call $copy_zstr (i32.const 341812) (local.get $p))))
    )
    (local.set $p (call $copy_json_esc (i32.const 345264) (i32.const 4) (local.get $p)))
    (local.set $p (call $copy_json_esc (i32.const 410900) (global.get $to_len) (local.get $p)))
    (local.set $p (call $copy_json_esc (i32.const 345280) (i32.const 9) (local.get $p)))
    (local.set $p (call $copy_json_esc (i32.const 411200) (call $utf8_clamp (i32.const 411200) (global.get $subj_len) (i32.const 160)) (local.get $p)))
    (if (i32.gt_s (global.get $err_len) (i32.const 0))
      (then
        (local.set $p (call $copy_json_esc (i32.const 343620) (i32.const 7) (local.get $p)))
        (local.set $p (call $copy_json_esc (i32.const 448000) (call $utf8_clamp (i32.const 448000) (global.get $err_len) (i32.const 400)) (local.get $p)))
      )
    )
    (local.set $p (call $copy_json_esc (i32.const 345568) (i32.const 152) (local.get $p)))
    (local.set $p (call $copy_zstr (i32.const 343140) (local.get $p)))
    (call $dispatch_host (i32.sub (local.get $p) (i32.const 560000)))
  )

  (func $call_ai_disconnect (result i32)
    (local $p i32)
