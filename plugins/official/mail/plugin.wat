  ;; ── AI Response Parser & Flutter UI Card Renderers ───────────────────

  (func $parse_ai_fields (param $res_ptr i32) (param $res_len i32)
    (local $tl i32)
    (global.set $ai_text_len (i32.const 0))
    (global.set $ai_intro_len (i32.const 0))
    (global.set $ai_ct_len (i32.const 0))
    (global.set $ai_cs_len (i32.const 0))
    (global.set $ai_badge_len (i32.const 0))
    (global.set $ai_guide_len (i32.const 0))
    (global.set $ai_ls_len (i32.const 0))
    (global.set $ai_vs_len (i32.const 0))
    (global.set $ai_la_len (i32.const 0))
    (global.set $ai_li_len (i32.const 0))
    (global.set $ai_lsmtp_len (i32.const 0))
    (global.set $ai_lu_len (i32.const 0))
    (global.set $ai_lp_len (i32.const 0))
    (global.set $ai_lc_len (i32.const 0))
    (global.set $ai_lf_len (i32.const 0))
    (global.set $ai_lt_len (i32.const 0))
    (global.set $ai_lsub_len (i32.const 0))
    (global.set $ai_ld_len (i32.const 0))
    (global.set $ai_empty_len (i32.const 0))
    (global.set $ai_utag_len (i32.const 0))
    (global.set $ai_b1_len (i32.const 0))
    (global.set $ai_b2_len (i32.const 0))
    (global.set $ai_b3_len (i32.const 0))
    (global.set $ai_err_len (i32.const 0))

    (if (i32.ne (call $extract_json_bool (local.get $res_ptr) (local.get $res_len) (i32.const 341080)) (i32.const 1))
      (then (return))
    )
    (local.set $tl (call $extract_json_str (local.get $res_ptr) (local.get $res_len) (i32.const 340564) (i32.const 480000) (i32.const 16000)))
    (if (i32.le_s (local.get $tl) (i32.const 0)) (then (return)))
    (global.set $ai_text_len (local.get $tl))

    (global.set $ai_intro_len (call $extract_json_str (i32.const 480000) (local.get $tl) (i32.const 341308) (i32.const 497000) (i32.const 1000)))
    (global.set $ai_ct_len (call $extract_json_str (i32.const 480000) (local.get $tl) (i32.const 341324) (i32.const 498100) (i32.const 180)))
    (global.set $ai_cs_len (call $extract_json_str (i32.const 480000) (local.get $tl) (i32.const 341344) (i32.const 498400) (i32.const 280)))
    (global.set $ai_badge_len (call $extract_json_str (i32.const 480000) (local.get $tl) (i32.const 341368) (i32.const 498800) (i32.const 48)))
    (global.set $ai_guide_len (call $extract_json_str (i32.const 480000) (local.get $tl) (i32.const 341384) (i32.const 499000) (i32.const 3200)))
    (global.set $ai_ls_len (call $extract_json_str (i32.const 480000) (local.get $tl) (i32.const 341400) (i32.const 502600) (i32.const 48)))
    (global.set $ai_vs_len (call $extract_json_str (i32.const 480000) (local.get $tl) (i32.const 341420) (i32.const 502700) (i32.const 120)))
    (global.set $ai_la_len (call $extract_json_str (i32.const 480000) (local.get $tl) (i32.const 341440) (i32.const 502900) (i32.const 48)))
    (global.set $ai_li_len (call $extract_json_str (i32.const 480000) (local.get $tl) (i32.const 341460) (i32.const 503000) (i32.const 48)))
    (global.set $ai_lsmtp_len (call $extract_json_str (i32.const 480000) (local.get $tl) (i32.const 341480) (i32.const 503100) (i32.const 48)))
    (global.set $ai_lu_len (call $extract_json_str (i32.const 480000) (local.get $tl) (i32.const 341500) (i32.const 503200) (i32.const 48)))
    (global.set $ai_lp_len (call $extract_json_str (i32.const 480000) (local.get $tl) (i32.const 341520) (i32.const 503300) (i32.const 48)))
    (global.set $ai_lc_len (call $extract_json_str (i32.const 480000) (local.get $tl) (i32.const 341544) (i32.const 503400) (i32.const 48)))
    (global.set $ai_lf_len (call $extract_json_str (i32.const 480000) (local.get $tl) (i32.const 341560) (i32.const 503500) (i32.const 48)))
    (global.set $ai_lt_len (call $extract_json_str (i32.const 480000) (local.get $tl) (i32.const 341580) (i32.const 503600) (i32.const 48)))
    (global.set $ai_lsub_len (call $extract_json_str (i32.const 480000) (local.get $tl) (i32.const 341596) (i32.const 503700) (i32.const 48)))
    (global.set $ai_ld_len (call $extract_json_str (i32.const 480000) (local.get $tl) (i32.const 341616) (i32.const 503800) (i32.const 48)))
    (global.set $ai_empty_len (call $extract_json_str (i32.const 480000) (local.get $tl) (i32.const 341636) (i32.const 503900) (i32.const 480)))
    (global.set $ai_utag_len (call $extract_json_str (i32.const 480000) (local.get $tl) (i32.const 341656) (i32.const 504500) (i32.const 48)))
    (global.set $ai_b1_len (call $extract_json_str (i32.const 480000) (local.get $tl) (i32.const 341676) (i32.const 504600) (i32.const 48)))
    (global.set $ai_b2_len (call $extract_json_str (i32.const 480000) (local.get $tl) (i32.const 341692) (i32.const 504700) (i32.const 48)))
    (global.set $ai_b3_len (call $extract_json_str (i32.const 480000) (local.get $tl) (i32.const 341708) (i32.const 504800) (i32.const 48)))
    (global.set $ai_err_len (call $extract_json_str (i32.const 480000) (local.get $tl) (i32.const 341724) (i32.const 504900) (i32.const 900)))
  )

  (func $emit_kv (param $kp i32) (param $kl i32) (param $vp i32) (param $vl i32) (param $first i32)
    (if (i32.eqz (local.get $first)) (then (call $out_z (i32.const 342576))))
    (call $out_z (i32.const 347176))
    (call $out_json_esc (local.get $kp) (local.get $kl) (i32.const 48))
    (call $out_z (i32.const 347196))
    (call $out_json_esc (local.get $vp) (local.get $vl) (i32.const 190))
    (call $out_z (i32.const 347216))
  )

  (func $emit_btn (param $lp i32) (param $ll i32) (param $cmd_z i32) (param $style_z i32) (param $first i32)
    (if (i32.eqz (local.get $first)) (then (call $out_z (i32.const 342576))))
    (call $out_z (i32.const 347452))
    (if (i32.gt_s (local.get $ll) (i32.const 0))
      (then (call $out_json_esc (local.get $lp) (local.get $ll) (i32.const 38)))
      (else (call $out_json_esc (local.get $cmd_z) (call $zlen (local.get $cmd_z)) (i32.const 38)))
    )
    (call $out_z (i32.const 347472))
    (call $out_z (local.get $cmd_z))
    (call $out_z (local.get $style_z))
  )

  (func $emit_ui_header (param $intro_p i32) (param $intro_l i32) (param $sub_p i32) (param $sub_l i32) (param $badge_fb i32) (param $style_z i32)
    (global.set $out_pos (i32.const 65536))
    (call $out_z (i32.const 346636))
    (if (i32.gt_s (local.get $intro_l) (i32.const 0))
      (then (call $out_json_esc (local.get $intro_p) (local.get $intro_l) (i32.const 900)))
    )
    (call $out_z (i32.const 346676))
    (if (i32.gt_s (global.get $ai_ct_len) (i32.const 0))
      (then (call $out_json_esc (i32.const 498100) (global.get $ai_ct_len) (i32.const 95)))
      (else (call $out_json_esc (i32.const 341756) (i32.const 5) (i32.const 95)))
    )
    (if (i32.gt_s (local.get $sub_l) (i32.const 0))
      (then
        (call $out_z (i32.const 346704))
        (call $out_json_esc (local.get $sub_p) (local.get $sub_l) (i32.const 180))
      )
    )
    (call $out_z (i32.const 346728))
    (if (i32.gt_s (global.get $ai_badge_len) (i32.const 0))
      (then (call $out_json_esc (i32.const 498800) (global.get $ai_badge_len) (i32.const 28)))
      (else (call $out_z (local.get $badge_fb)))
    )
    (call $out_z (local.get $style_z))
  )

  ;; Render Status UI Card (state 20)
  (func $render_status_ui (result i32)
    (local $sub_p i32) (local $sub_l i32)
    (local $nlen i32)
    (local $p i32)
    (local.set $sub_p (i32.const 498400))
    (local.set $sub_l (global.get $ai_cs_len))
    (if (i32.and (i32.le_s (local.get $sub_l) (i32.const 0)) (i32.gt_s (global.get $se_len) (i32.const 0)))
      (then (local.set $sub_p (i32.const 447000)) (local.set $sub_l (global.get $se_len)))
    )

    ;; Unconfigured -> Orange Warning Card
    (if (i32.eqz (global.get $g_configured))
      (then
        (call $emit_ui_header (i32.const 497000) (global.get $ai_intro_len) (local.get $sub_p) (local.get $sub_l) (i32.const 341784) (i32.const 346824))
        (call $out_z (i32.const 347136))
        (call $emit_kv
          (if (result i32) (i32.gt_s (global.get $ai_ls_len) (i32.const 0)) (then (i32.const 502600)) (else (i32.const 340740)))
          (if (result i32) (i32.gt_s (global.get $ai_ls_len) (i32.const 0)) (then (global.get $ai_ls_len)) (else (i32.const 6)))
          (if (result i32) (i32.gt_s (global.get $ai_vs_len) (i32.const 0)) (then (i32.const 502700)) (else (i32.const 341812)))
          (if (result i32) (i32.gt_s (global.get $ai_vs_len) (i32.const 0)) (then (global.get $ai_vs_len)) (else (i32.const 5)))
          (i32.const 1))
        (call $emit_kv
          (if (result i32) (i32.gt_s (global.get $ai_lc_len) (i32.const 0)) (then (i32.const 503400)) (else (i32.const 340772)))
          (if (result i32) (i32.gt_s (global.get $ai_lc_len) (i32.const 0)) (then (global.get $ai_lc_len)) (else (i32.const 6)))
          (i32.const 341888) (i32.const 36) (i32.const 0))
        (call $out_z (i32.const 347368))
        (if (i32.gt_s (global.get $ai_guide_len) (i32.const 0))
          (then
            (call $out_z (i32.const 342576))
            (call $out_z (i32.const 347320))
            (call $out_json_esc (i32.const 499000) (global.get $ai_guide_len) (i32.const 3200))
            (call $out_z (i32.const 347356))
          )
        )
        (call $out_z (i32.const 342576))
        (call $out_z (i32.const 347380))
        (call $out_z (i32.const 342576))
        (call $out_z (i32.const 347408))
        (call $emit_btn (i32.const 504600) (global.get $ai_b1_len) (i32.const 341976) (i32.const 347512) (i32.const 1))
        (call $out_z (i32.const 347368))
        (call $out_z (i32.const 347620))
        (return (i32.sub (global.get $out_pos) (i32.const 65536)))
      )
    )

    ;; Configured & Live IMAP Verified -> Green Card
    (if (global.get $g_verified)
      (then
        (call $emit_ui_header (i32.const 497000) (global.get $ai_intro_len) (local.get $sub_p) (local.get $sub_l) (i32.const 341772) (i32.const 346748))
        (call $out_z (i32.const 347136))
        (call $emit_kv
          (if (result i32) (i32.gt_s (global.get $ai_la_len) (i32.const 0)) (then (i32.const 502900)) (else (i32.const 340240)))
          (if (result i32) (i32.gt_s (global.get $ai_la_len) (i32.const 0)) (then (global.get $ai_la_len)) (else (i32.const 7)))
          (i32.const 447000) (global.get $se_len) (i32.const 1))
        (call $emit_kv
          (if (result i32) (i32.gt_s (global.get $ai_ls_len) (i32.const 0)) (then (i32.const 502600)) (else (i32.const 340740)))
          (if (result i32) (i32.gt_s (global.get $ai_ls_len) (i32.const 0)) (then (global.get $ai_ls_len)) (else (i32.const 6)))
          (if (result i32) (i32.gt_s (global.get $ai_vs_len) (i32.const 0)) (then (i32.const 502700)) (else (i32.const 341772)))
          (if (result i32) (i32.gt_s (global.get $ai_vs_len) (i32.const 0)) (then (global.get $ai_vs_len)) (else (i32.const 2)))
          (i32.const 0))
        (call $emit_kv
          (if (result i32) (i32.gt_s (global.get $ai_li_len) (i32.const 0)) (then (i32.const 503000)) (else (i32.const 340580)))
          (if (result i32) (i32.gt_s (global.get $ai_li_len) (i32.const 0)) (then (global.get $ai_li_len)) (else (i32.const 8)))
          (if (result i32) (i32.gt_s (global.get $si_len) (i32.const 0)) (then (i32.const 447300)) (else (i32.const 341828)))
          (if (result i32) (i32.gt_s (global.get $si_len) (i32.const 0)) (then (global.get $si_len)) (else (i32.const 14)))
          (i32.const 0))
        ;; SMTP host:port into 449200
        (local.set $p (i32.const 449200))
        (if (i32.gt_s (global.get $ss_len) (i32.const 0))
          (then (local.set $p (call $copy_mem (i32.const 447600) (local.get $p) (global.get $ss_len))))
          (else (local.set $p (call $copy_zstr (i32.const 341852) (local.get $p))))
        )
        (local.set $p (call $copy_zstr (i32.const 342040) (local.get $p)))
        (if (i32.gt_s (global.get $sp_len) (i32.const 0))
          (then (local.set $p (call $copy_mem (i32.const 447900) (local.get $p) (global.get $sp_len))))
          (else (local.set $p (call $copy_zstr (i32.const 341876) (local.get $p))))
        )
        (call $emit_kv
          (if (result i32) (i32.gt_s (global.get $ai_lsmtp_len) (i32.const 0)) (then (i32.const 503100)) (else (i32.const 340660)))
          (if (result i32) (i32.gt_s (global.get $ai_lsmtp_len) (i32.const 0)) (then (global.get $ai_lsmtp_len)) (else (i32.const 8)))
          (i32.const 449200) (i32.sub (local.get $p) (i32.const 449200)) (i32.const 0))
        ;; Unread count
        (local.set $nlen (i32.sub (call $copy_int_str (global.get $g_unread_cnt) (i32.const 449200)) (i32.const 449200)))
        (call $emit_kv
          (if (result i32) (i32.gt_s (global.get $ai_lu_len) (i32.const 0)) (then (i32.const 503200)) (else (i32.const 341276)))
          (if (result i32) (i32.gt_s (global.get $ai_lu_len) (i32.const 0)) (then (global.get $ai_lu_len)) (else (i32.const 6)))
          (i32.const 449200) (local.get $nlen) (i32.const 0))
        (call $out_z (i32.const 347368))
        (call $out_z (i32.const 342576))
        (call $out_z (i32.const 347380))
        (call $out_z (i32.const 342576))
        (call $out_z (i32.const 347408))
        (call $emit_btn (i32.const 504600) (global.get $ai_b1_len) (i32.const 341952) (i32.const 347512) (i32.const 1))
        (call $emit_btn (i32.const 504700) (global.get $ai_b2_len) (i32.const 341976) (i32.const 347544) (i32.const 0))
        (call $emit_btn (i32.const 504800) (global.get $ai_b3_len) (i32.const 341996) (i32.const 347576) (i32.const 0))
        (call $out_z (i32.const 347368))
        (call $out_z (i32.const 347620))
        (return (i32.sub (global.get $out_pos) (i32.const 65536)))
      )
    )

    ;; Configured, IMAP verification failed -> Red Error Card
    (call $emit_ui_header
      (if (result i32) (i32.gt_s (global.get $ai_intro_len) (i32.const 0)) (then (i32.const 497000)) (else (i32.const 448000)))
      (if (result i32) (i32.gt_s (global.get $ai_intro_len) (i32.const 0)) (then (global.get $ai_intro_len)) (else (global.get $err_len)))
      (local.get $sub_p) (local.get $sub_l) (i32.const 341784) (i32.const 346904))
    (call $out_z (i32.const 347136))
    (call $emit_kv
      (if (result i32) (i32.gt_s (global.get $ai_la_len) (i32.const 0)) (then (i32.const 502900)) (else (i32.const 340240)))
      (if (result i32) (i32.gt_s (global.get $ai_la_len) (i32.const 0)) (then (global.get $ai_la_len)) (else (i32.const 7)))
      (i32.const 447000) (global.get $se_len) (i32.const 1))
    (call $emit_kv
      (if (result i32) (i32.gt_s (global.get $ai_li_len) (i32.const 0)) (then (i32.const 503000)) (else (i32.const 340580)))
      (if (result i32) (i32.gt_s (global.get $ai_li_len) (i32.const 0)) (then (global.get $ai_li_len)) (else (i32.const 8)))
      (if (result i32) (i32.gt_s (global.get $si_len) (i32.const 0)) (then (i32.const 447300)) (else (i32.const 341828)))
      (if (result i32) (i32.gt_s (global.get $si_len) (i32.const 0)) (then (global.get $si_len)) (else (i32.const 14)))
      (i32.const 0))
    (call $out_z (i32.const 347368))
    (call $out_z (i32.const 342576))
    (call $out_z (i32.const 347320))
    (if (i32.gt_s (global.get $ai_err_len) (i32.const 0))
