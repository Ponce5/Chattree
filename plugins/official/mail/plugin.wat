  (data (i32.const 347368) "]}\00") ;; ui_arr_end (len=2)
  (data (i32.const 347380) "{\22type\22:\22divider\22}\00") ;; ui_div (len=18)
  (data (i32.const 347408) "{\22type\22:\22button_row\22,\22buttons\22:[\00") ;; ui_btn_start (len=32)
